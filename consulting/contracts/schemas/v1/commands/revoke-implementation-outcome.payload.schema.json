{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:sekinfra:schema:contracts:commands:revoke-implementation-outcome-payload:v1","title":"Revoke Implementation Outcome Payload v1","description":"Revokes one exact approved ImplementationOutcome under trusted SekInfra human authority. Revocation timestamp remains server-derived and no implementation or deployment authority is created.","type":"object","additionalProperties":false,"required":["implementation_outcome_id","outcome_version","reason"],"properties":{"implementation_outcome_id":{"$ref":"urn:sekinfra:schema:contracts:domain:implementation-outcome:v1#/properties/implementation_outcome_id"},"outcome_version":{"$ref":"urn:sekinfra:schema:contracts:domain:implementation-outcome:v1#/properties/outcome_version"},"reason":{"$ref":"urn:sekinfra:schema:contracts:domain:implementation-outcome:v1#/properties/terminal_reason"}}}