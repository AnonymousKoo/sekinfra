{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:sekinfra:schema:contracts:commands:record-implementation-outcome-approval-payload:v1","title":"Record Implementation Outcome Approval Payload v1","description":"Records one attributable trusted-human approval over an exact ImplementationOutcome version and server-derived authority digest. Approval identity, correlation, idempotency, actor identity, and timestamps are envelope/server-derived.","type":"object","additionalProperties":false,"required":["implementation_outcome_id","outcome_version","authority_role","evidence_reference"],"properties":{"implementation_outcome_id":{"$ref":"urn:sekinfra:schema:contracts:domain:implementation-outcome:v1#/properties/implementation_outcome_id"},"outcome_version":{"$ref":"urn:sekinfra:schema:contracts:domain:implementation-outcome:v1#/properties/outcome_version"},"authority_role":{"type":"string","enum":["CLIENT_DECISION_AUTHORITY","SEKINFRA_ENGAGEMENT_AUTHORITY"]},"evidence_reference":{"$ref":"urn:sekinfra:schema:contracts:domain:human-approval:v1#/$defs/evidenceReference"}}}