{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sekinfra:schema:contracts:domain:implementation-outcome:v1",
  "title": "Sekinfra Implementation Outcome v1",
  "description": "Authoritative Sekinfra approval boundary for one exact accepted conversion and selected delivered Finding set. It authorizes handoff production only and never implementation or deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "implementation_outcome_id",
    "implementation_handoff_id",
    "tenant_id",
    "engagement_id",
    "outcome_version",
    "handoff_version",
    "record_version",
    "state",
    "source_conversion_reference",
    "selected_finding_revisions",
    "client_reference",
    "approved_scope",
    "excluded_scope",
    "constraints",
    "context_references",
    "integrations",
    "allowed_access_level",
    "risks",
    "implementation_requirements",
    "acceptance_criteria",
    "prohibited_changes",
    "dependencies",
    "assumptions_limitations",
    "outcome_authority_digest",
    "implementation_authority_granted",
    "deployment_authority_granted",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "implementation_outcome_id": {
      "$ref": "#/$defs/uuid"
    },
    "implementation_handoff_id": {
      "$ref": "#/$defs/uuid"
    },
    "tenant_id": {
      "$ref": "#/$defs/uuid"
    },
    "engagement_id": {
      "$ref": "#/$defs/uuid"
    },
    "outcome_version": {
      "$ref": "#/$defs/version"
    },
    "record_version": {
      "$ref": "#/$defs/version"
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "APPROVED",
        "SUPERSEDED",
        "REVOKED"
      ]
    },
    "source_conversion_reference": {
      "$ref": "#/$defs/digestReference"
    },
    "selected_finding_revisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/findingReference"
      }
    },
    "client_reference": {
      "$ref": "#/$defs/shortText"
    },
    "approved_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/scopeItem"
      }
    },
    "excluded_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/boundedText"
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/boundedText"
      }
    },
    "context_references": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/opaqueReference"
      }
    },
    "integrations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/namedStatement"
      }
    },
    "allowed_access_level": {
      "type": "string",
      "enum": [
        "NO_DIRECT_ACCESS",
        "READ_ONLY",
        "SANDBOX_ONLY",
        "NON_PRODUCTION_BOUNDED"
      ]
    },
    "risks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/namedStatement"
      }
    },
    "implementation_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/namedStatement"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "prohibited_changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/boundedText"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/namedStatement"
      }
    },
    "assumptions_limitations": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/boundedText"
      }
    },
    "outcome_authority_digest": {
      "$ref": "#/$defs/digest"
    },
    "supersedes_outcome_reference": {
      "$ref": "#/$defs/outcomeReference"
    },
    "supersedes_handoff_reference": {
      "$ref": "#/$defs/handoffReference"
    },
    "implementation_authority_granted": {
      "const": false
    },
    "deployment_authority_granted": {
      "const": false
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "terminal_at": {
      "type": "string",
      "format": "date-time"
    },
    "terminal_reason": {
      "$ref": "#/$defs/boundedText"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "handoff_version": {
      "$ref": "#/$defs/version"
    },
    "upstream_approval_references": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/outcomeApprovalReference"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "opaqueReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_type",
        "reference_id"
      ],
      "properties": {
        "reference_type": {
          "$ref": "#/$defs/shortText"
        },
        "reference_id": {
          "$ref": "#/$defs/shortText"
        },
        "reference_version": {
          "$ref": "#/$defs/version"
        },
        "reference_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "digestReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "reference_version",
        "reference_digest"
      ],
      "properties": {
        "reference_id": {
          "$ref": "#/$defs/uuid"
        },
        "reference_version": {
          "$ref": "#/$defs/version"
        },
        "reference_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "handoffReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_type",
        "reference_id",
        "reference_version",
        "reference_digest"
      ],
      "properties": {
        "reference_type": {
          "const": "IMPLEMENTATION_HANDOFF"
        },
        "reference_id": {
          "$ref": "#/$defs/uuid"
        },
        "reference_version": {
          "$ref": "#/$defs/version"
        },
        "reference_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "findingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oia_finding_id",
        "finding_revision",
        "content_digest"
      ],
      "properties": {
        "oia_finding_id": {
          "$ref": "#/$defs/uuid"
        },
        "finding_revision": {
          "$ref": "#/$defs/version"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "namedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/shortText"
        },
        "statement": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "expected_condition",
        "evidence_requirement"
      ],
      "properties": {
        "criterion_id": {
          "$ref": "#/$defs/shortText"
        },
        "expected_condition": {
          "$ref": "#/$defs/boundedText"
        },
        "evidence_requirement": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "scopeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_item_id",
        "description",
        "action_classes",
        "target_references"
      ],
      "properties": {
        "scope_item_id": {
          "$ref": "#/$defs/shortText"
        },
        "description": {
          "$ref": "#/$defs/boundedText"
        },
        "action_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortText"
          }
        },
        "target_references": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/opaqueReference"
          }
        }
      }
    },
    "outcomeApprovalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_role",
        "approval_reference",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "approval_role": {
          "type": "string",
          "enum": [
            "CLIENT_APPROVER",
            "PROVIDER_APPROVER"
          ]
        },
        "approval_reference": {
          "$ref": "#/$defs/uuid"
        },
        "approved_by": {
          "$ref": "#/$defs/shortText"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "outcomeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_type",
        "reference_id",
        "reference_version",
        "reference_digest"
      ],
      "properties": {
        "reference_type": {
          "const": "IMPLEMENTATION_OUTCOME"
        },
        "reference_id": {
          "$ref": "#/$defs/uuid"
        },
        "reference_version": {
          "$ref": "#/$defs/version"
        },
        "reference_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "APPROVED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "upstream_approval_references",
          "approved_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "SUPERSEDED",
              "REVOKED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "terminal_at",
          "terminal_reason"
        ]
      }
    }
  ]
}
